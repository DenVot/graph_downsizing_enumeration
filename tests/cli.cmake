execute_process(COMMAND "${EXECUTABLE}" validate --config "${WORK_DIR}/invalid.json"
    RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT "${code}" STREQUAL "1" OR "${output}${error}" MATCHES "fake-secret-for-test")
    message(FATAL_ERROR "Invalid JSON must fail without exposing the token")
endif()

